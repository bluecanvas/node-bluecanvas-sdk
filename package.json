{
  "name": "@bluecanvas/sdk",
  "version": "3.0.0",
  "description": "Official library for using the Blue Canvas API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "bluecanvas.io",
  "scripts": {
    "clean": "rimraf dist types",
    "docs:gen": "rimraf docs && typedoc --plugin typedoc-plugin-markdown --excludePrivate --excludeProtected --hideBreadcrumbs --readme none --out docs",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecanvas/node-bluecanvas-sdk.git"
  },
  "keywords": [
    "bluecanvas",
    "api",
    "http",
    "salesforce",
    "client"
  ],
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.4",
    "axios": "^1.7.2",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
